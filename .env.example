# এই ফাইলের নাম বদলে .env করুন (লোকাল ডেভেলপমেন্টের জন্য)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# আপনার React সাইটের ঠিকানা (কমা দিয়ে একাধিক দেওয়া যায়, শেষে / দেবেন না)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# ডেটাবেজ: না দিলে SQLite ব্যবহার হবে
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# নতুন মেসেজ এলে ইমেইল পেতে চাইলে (ঐচ্ছিক, PythonAnywhere ফ্রিতে কাজ করবে না)
# CONTACT_NOTIFY_EMAIL=you@example.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=app-password
